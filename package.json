{
  "name": "blockfrost-backend-ryo",
  "version": "6.8.1",
  "description": "",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "blockfrost.io",
  "scripts": {
    "build": "yarn clean && tsc && cp -R src/sql/* dist/sql",
    "clean": "rimraf dist",
    "coverage": "vitest run --coverage",
    "dev": "cross-env NODE_OPTIONS='--max-http-header-size 32768' NODE_ENV=development yarn run-dev",
    "dev-testnet": "cross-env NODE_OPTIONS='--max-http-header-size 32768' NODE_ENV=development-testnet yarn run-dev",
    "lint": "eslint ./src/**/*.ts",
    "run-dev": "nodemon --preserve-symlinks src/server.ts",
    "start": "yarn build && node --max-http-header-size=32768 dist/server.js",
    "start-mainnet": "cross-env-shell NODE_ENV=mainnet \"yarn start\"",
    "start-testnet": "cross-env-shell NODE_ENV=testnet \"yarn start\"",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS='--max-http-header-size 32768' vitest",
    "test-badges": "make-coverage-badge --output-path ./docs/images/badge.svg",
    "type-check": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@blockfrost/blockfrost-js": "6.2.0",
    "@blockfrost/blockfrost-utils": "3.0.0",
    "@blockfrost/openapi": "0.1.93",
    "@fastify/cors": "^11.3.1",
    "@fastify/http-proxy": "^11.6.5",
    "@fastify/postgres": "^6.1.1",
    "@prometheus-io/client": "^0.16.1",
    "@sentry/node": "^11.8.0",
    "JSONStream": "^1.3.5",
    "ajv": "^8.20.0",
    "axios": "^1.20.0",
    "bech32": "^2.0.0",
    "config": "5.0.1",
    "crc": "^4.3.2",
    "cross-env": "^10.1.0",
    "fastify": "5.12.7",
    "fastify-metrics": "^14.1.1",
    "fastify-plugin": "^6.0.1",
    "nock": "^15.0.5",
    "path-to-regexp": "^8.4.2",
    "pg": "^8.23.1",
    "pino-pretty": "13.2.0",
    "rimraf": "^6.1.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/blake2b": "^2.1.3",
    "@types/config": "4.4.0",
    "@types/node": "24",
    "@types/pg": "^8.23.1",
    "@types/sinon": "^22.0.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "5.0.5",
    "blake2b": "^2.1.4",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-unicorn": "^78.0.0",
    "make-coverage-badge": "^1.2.0",
    "nodemon": "^3.1.14",
    "prettier": "3.9.10",
    "sinon": "^22.1.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "yarn@3.6.3",
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
